@{
    ViewData["Title"] = "Ejecución de Evento";
    Layout = "~/Views/Shared/_rfidLayout.cshtml";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card p-5 text-center" style="max-width: 500px;">
        <img src="/media/imgs/img_dev.png" alt="BiblioTrack Logo" class="logo mx-auto d-block mb-4 animate-fadeInUp">
        <h1 class="animate-fadeInUp font-weight-boldest" style="animation-delay: 0.2s;">BiblioTrack</h1>
        <p class="lead mb-4 animate-fadeInUp font-weight-bolder" style="animation-delay: 0.3s;">Facilitando tus Hobbies</p>
    </div>
</div>

<!-- Prestamo Modal -->
<div class="modal fade" id="staticPrestamo" data-backdrop="static" data-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tituloModalPrestamo">Préstamo de Libro</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            
            <div class="modal-body">
                <form id="dataLoan">
                    <div class="row" hidden>
                        <div class="col">
                            <input id="IdLibro" type="number" class="form-control" disabled>
                            <input id="IdEjemplar" type="number" class="form-control" disabled>
                            <input id="IdUsuario" type="number" class="form-control" disabled>
                            <input id="IdPrestamo" type="number" class="form-control" disabled>
                        </div>
                    </div>

                    <div class="row align-items-start">
                        <div class="col-8">
                            <label for="Usuario" class="form-label">Usuario del Prestamo</label>
                            <div class="input-group mb-3">
                                <input type="text" class="form-control" id="Usuario" placeholder="Seleccione el Usuario" disabled>
                                <button class="btn btn-outline-success" id="btnSearchUser" type="button" data-toggle="modal" data-target="#staticUser" onclick="resetFormUser();"><i class="fas fa-search"></i> Buscar</button>
                            </div>
                        </div>
                        <div class="col-4">
                            <label for="DiasPrestamo" class="form-label">Días de Préstamo</label>
                            <input id="DiasPrestamo" type="number" class="form-control">
                        </div>
                    </div><br />
                    <div id="validation"></div><hr />

                    <div class="row">
                        <div class="col-2">
                            <div id="miniaturaContainer"></div>
                        </div>
                        <div class="col-10">
                            <div class="input-group mb-3">
                                <input type="text" class="form-control" id="Libro" placeholder="Seleccione el Libro" disabled>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-info font-weight-bold" onclick="prestar();"><i class="fas fa-handshake"></i> Entregar </button>
                <button id="btnCancelPrestamo" type="button" data-dismiss="modal" class="btn btn-danger"><i class="fas fa-times"></i> Cancelar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Selección del Usuario a prestar -->
<div class="modal fade" id="staticUser" data-backdrop="static" data-keyboard="false" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tituloModalUsuario"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <table id="tableUsuarios" class="table table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th scope="col">DUI</th>
                            <th scope="col">Usuario</th>
                            <th scope="col">Nombre</th>
                            <th scope="col">Teléfono</th>
                            <th scope="col">Fecha Nacimiento</th>
                            <th scope="col">Género</th>
                        </tr>
                    </thead>
                    <tbody id="tUsuarios"></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <center>
                    <button id="btnCancelUser" type="button" data-dismiss="modal" onclick="resetFormUser();" class="btn btn-danger"><i class="fas fa-times"></i> Cancelar</button>
                </center>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Recepción del Prestamo -->
<div class="modal fade" id="staticDevolucion" data-backdrop="static" data-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Datos del Préstamo</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="dataDevolucion">
                    <div class="row" hidden>
                        <div class="col">
                            <input id="IdDevolucion" type="number" class="form-control" disabled>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col" id="StatusPrestamo"></div>
                    </div>

                    <div class="row">
                        <div class="col-3">
                            <label for="UsuarioDevolucion" class="form-label">Usuario del Préstamo</label>
                            <input id="UsuarioDevolucion" type="text" class="form-control" disabled>
                        </div>
                        <div class="col-3">
                            <label for="DUIDevolucion" class="form-label">DUI del Usuario</label>
                            <input id="DUIDevolucion" type="text" class="form-control" disabled>
                        </div>
                        <div class="col-3">
                            <label for="TelefonoDevolucion" class="form-label">Télefono del Usuario</label>
                            <input id="TelefonoDevolucion" type="text" class="form-control" disabled>
                        </div>
                        <div class="col-3">
                            <label for="CorreoDevolucion" class="form-label">Correo del Usuario</label>
                            <input id="CorreoDevolucion" type="text" class="form-control" disabled>
                        </div>
                    </div><hr />

                    <div class="row">
                        <div class="col-4">
                            <label for="UsuarioEntrego" class="form-label">Usuario que Entregó</label>
                            <input id="UsuarioEntrego" type="text" class="form-control" disabled>
                        </div>
                        <div class="col-4">
                            <label for="DiasPrestamoDevolucion" class="form-label">Días de Préstamo</label>
                            <input id="DiasPrestamoDevolucion" type="number" class="form-control" disabled>
                        </div>
                        <div class="col-4">
                            <label for="FechaPrestamo" class="form-label">Fecha del Préstamo</label>
                            <input id="FechaPrestamo" class="form-control" disabled>
                        </div>
                    </div>
                    <hr />

                    <div class="row">
                        <div class="col-2">
                            <div id="miniaturaContainerDevolucion"></div>
                        </div>
                        <div class="col-10">
                            <label for="LibroDevolucion" class="form-label">Libro del Préstamo</label>
                            <input id="LibroDevolucion" type="text" class="form-control" disabled>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <center>
                    <button onclick="recibir();" type="button" class="btn btn-info font-weight-bold"><i class="fas fa-sign-in-alt"></i> Recibir </button>
                    <button id="btnCancelDevolucion" type="button" data-dismiss="modal" class="btn btn-danger"><i class="fas fa-times"></i> Cancelar</button>
                </center>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Cobro de Multa al Prestamo tardío -->
<div class="modal fade" id="staticMulta" data-backdrop="static" data-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Multa por Retraso</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="dataMulta">
                    <div class="row">
                        <div class="col">
                            <div class="alert alert-warning text-center font-weight-bolder" role="alert" id="retrasoAlert">
                                EL USUARIO TIENE X DIAS DE RETRASO EN SU PRÉSTAMO
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <label for="UsuarioMulta" class="form-label">Usuario del Préstamo</label>
                            <input id="UsuarioMulta" type="text" class="form-control" disabled>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-6">
                            <label for="FechaPrestamoMulta" class="form-label">Fecha que se Prestó</label>
                            <input id="FechaPrestamoMulta" type="text" class="form-control" disabled>
                        </div>
                        <div class="col-6">
                            <label for="DiasPrestamoMulta" class="form-label">Días Préstamo Solicitados</label>
                            <input id="DiasPrestamoMulta" type="text" class="form-control" disabled>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-6">
                            <label for="DiasRetrazo" class="form-label">Días de Retrazo</label>
                            <input id="DiasRetrazo" type="text" class="form-control" disabled>
                        </div>
                        <div class="col-6">
                            <label for="TotalPago" class="form-label">Total a Pagar</label>
                            <div class="input-group mb-3">
                                <span class="input-group-text">$</span>
                                <input id="dollars" type="text" class="form-control" aria-label="Amount (to the nearest dollar)" value="10" disabled>
                                <span id="cents" class="input-group-text">.50</span>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <center>
                    <button onclick="cobrar();" type="button" class="btn btn-warning font-weight-bold"><i class="fas fa-hand-holding-usd"></i> Cobrar </button>
                    <button onclick="generar();" type="button" class="btn btn-info font-weight-bold"><i class="fas fa-file-invoice-dollar"></i> Generar Cobro </button>
                    <button id="btnCancelMulta" type="button" data-dismiss="modal" class="btn btn-danger"><i class="fas fa-times"></i> Cancelar</button>
                </center>
            </div>
        </div>
    </div>
</div>

<script src="~/js/rfid_module/rfid.js"></script>
<script src="~/js/rfid_module/rfid.actions.js"></script>