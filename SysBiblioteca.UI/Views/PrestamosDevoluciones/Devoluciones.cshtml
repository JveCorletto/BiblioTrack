
@{
    ViewData["Title"] = "Devoluciones";
    Layout = "~/Views/Shared/_emptyLayout.cshtml";
}

<style>
    body {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
    }

    .container {
        display: flex;
        max-width: 70%;
    }
</style>



<body>
    <h1>Gestión de devolución</h1>
    <div class="row row-cols-1 row-cols-md-2 g-4" style="width:50%;">
        <div class="col" >
            <div class="card h-80" >
                <img src="~/Media/imgs/img_dev.png" class="card-img-top" alt="..." style="height:55%">
                <div class="card-body">
                    <h5 class="card-title">Devolucion</h5>
                    <p class="card-text">Inicia el proceso de devolucion de libros.</p>
                    <a href="#" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#staticBackdrop">Devolver</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-80">
                <img src="~/Media/imgs/img_hist_dev.png" class="card-img-top" alt="..." style="height:55%">
                <div class="card-body">
                    <h5 class="card-title">Historial de devoluciones</h5>
                    <p class="card-text">Consulta aqui el historial de todas la devoluciones de libros.</p>
                    <a href="#" class="btn btn-primary">Historial de devoluciones</a>
                </div>
            </div>
        </div>
    </div>


    <!-- Modal de prueba, de momento inactivo -->
    <div class="modal-dialog modal-lg" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="staticBackdropLabel">Modal title</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    ...
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary">Understood</button>
                </div>
            </div>
        </div>
    </div>
</body>