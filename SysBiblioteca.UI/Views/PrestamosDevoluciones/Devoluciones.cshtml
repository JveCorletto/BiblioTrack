
@{
    ViewData["Title"] = "Devoluciones";
    Layout = "~/Views/Shared/_emptyLayout.cshtml";
}

<style>
    body {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
    }

    .container {
        display: flex;
        max-width: 70%;
    }

    .box {
        flex: 1;
        border: 4px solid #ccc;
        box-sizing: border-box;
        max-width: 40%;
        margin: 5%;
    }

    .box1 {
        flex: 2;
        border: 4px solid #ccc;
        box-sizing: border-box;
        max-width: 40%;
        margin: 5%;
    }

    .top-section {
        padding: 20px;
        text-align: center;
        border-bottom: 1px solid #ccc;
        height: 10%;
    }

    .bottom-section {
        padding: 10px;
        text-align: center;
        height: 80%;
    }

    img {
        max-width: 100%;
        height: auto;
    }

    .btn_dev {
        background-color: darkblue;
        color: white;
        -webkit-border-radius: 33px;
        -moz-border-radius: 33px;
        border-radius: 33px;
    }
</style>


<body>
    <h1>Gestión de devolución</h1>
    <div class="container">
        <div class="box">
            <div class="top-section">
                <button class="btn_dev">Devolver</button>
            </div>
            <div class="bottom-section">
                <!-- Contenido de la sección inferior -->
                <img src="dev_img.png" alt="Imagen">
            </div>
        </div>
        <div class="box1">
            <div class="top-section">
                <button class="btn_dev">Historial de devoluciones</button>
            </div>
            <div class="bottom-section">
                <!-- Contenido de la sección inferior -->
                <img src="tu_imagen.jpg" alt="Imagen">
            </div>
        </div>
    </div>

</body>


