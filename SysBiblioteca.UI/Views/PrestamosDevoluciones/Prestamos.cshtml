@{
    ViewData["Title"] = "Prestamos";
    Layout = "~/Views/Shared/_emptyLayout.cshtml";
}

<!--Subheader-->
<div class="subheader py-6 py-lg-8 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h2 class="text-dark font-weight-bold my-1 mr-5">Prestamo de Libros</h2>
            </div>
        </div>

        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#staticLoan" onclick="resetForm();" id="openModal">
            <i class="fas fa-handshake"></i> Nuevo Prestamo
        </button>
    </div>
</div>

<!--Cuerpo del Docto-->
<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="card card-custom">
            <div class="card-body">
                <!-- Nav tabs -->
                <ul class="nav nav-tabs justify-content-start" id="EncabezadoTabs">
                    <li class='nav-item' id="tabActivos">
                        <a class='nav-link ' data-toggle='tab' href='#PrestamosActivos'>Prestamos Activos</a>
                    </li>
                    <li class='nav-item' id="tabPendientes">
                        <a class='nav-link' data-toggle='tab' href='#PrestamosPendientes'>Prestamos Pendientes de Entrega</a>
                    </li>
                </ul>

                <!-- Tabs-->
                <div class="tab-content" Id="CuerpoTabs">

                    @*Empleados Activos*@
                    <div class='tab-pane fade' id='PrestamosActivos'>
                        <br />
                        <table id="tableActivos" class="table table-hover">
                            <thead class="thead-dark">
                                <tr>
                                    <th scope="col" width="100"></th>
                                    <th scope="col">Libro</th>
                                    <th scope="col">Días Prestamo</th>
                                    <th scope="col">Fecha Prestamo</th>
                                    <th scope="col">Usuario Prestamo</th>
                                    <th scope="col">Usuario Entregó</th>
                                    <th scope="col">Estado Prestamo</th>
                                </tr>
                            </thead>
                            <tbody id="tActivos"></tbody>
                        </table>
                    </div>

                    @*Prestamos Pendientes de Entrega*@
                    <div class='tab-pane fade' id='PrestamosPendientes'>
                        <br />
                        <table id="tablePrestamosPendientes" class="table table-hover">
                            <thead class="thead-dark">
                                <tr>
                                    <th scope="col" width="25"></th>
                                    <th scope="col">Libro</th>
                                    <th scope="col">Días Prestamo</th>
                                    <th scope="col">Usuario Prestamo</th>
                                    <th scope="col">Estado Prestamo</th>
                                </tr>
                            </thead>
                            <tbody id="tPrestamosPendientes"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Creación de Prestamo -->
<div class="modal fade" id="staticLoan" data-backdrop="static" data-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tituloModal"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="dataLoan">
                    <div class="row" hidden>
                        <div class="col">
                            <input id="IdPrestamo" type="number" class="form-control" disabled>
                            <input id="IdLibro" type="number" class="form-control" disabled>
                            <input id="IdUsuario" type="number" class="form-control" disabled>
                        </div>
                    </div>

                    <div class="row align-items-start">
                        <div class="col-8">
                            <label for="Usuario" class="form-label">Usuario del Prestamo</label>
                            <div class="input-group mb-3">
                                <input type="text" class="form-control" id="Usuario" placeholder="Seleccione el Usuario" disabled>
                                <button class="btn btn-outline-success" id="btnSearchUser" type="button" data-toggle="modal" data-target="#staticUser" onclick="resetFormUser();"><i class="fas fa-search"></i> Buscar</button>
                            </div>
                        </div>
                        <div class="col-4">
                            <label for="DiasPrestamo" class="form-label">Días de Préstamo</label>
                            <input id="DiasPrestamo" type="number" class="form-control">
                        </div>
                    </div>
                    <br /><div id="validation"></div><hr />

                    <div class="row">
                        <div class="col-2">
                            <div id="miniaturaContainer"></div>
                        </div>
                        <div class="col-10">
                            <div class="input-group mb-3">
                                <input type="text" class="form-control" id="Libro" placeholder="Seleccione el Libro" disabled>
                                <button class="btn btn-outline-success" id="btnSearchBook" type="button" data-toggle="modal" data-target="#staticBook" onclick="resetFormBook();"><i class="fas fa-search"></i> Buscar</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <center>
                    <button id="btnEntregar" type="button" class="btn btn-info font-weight-bold"><i class="fas fa-handshake"></i> Entregar </button>

                    <button id="btnSave" type="button" class="btn btn-success font-weight-bold"><i class="fas fa-handshake"></i> Realizar Prestamo </button>
                    <button id="btnCancel" type="button" data-dismiss="modal" onclick="resetForm();" class="btn btn-danger"><i class="fas fa-times"></i> Cancelar</button>
                </center>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Selección del Usuario a prestar -->
<div class="modal fade" id="staticUser" data-backdrop="static" data-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tituloModalUsuario"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <table id="tableUsuarios" class="table table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th scope="col">DUI</th>
                            <th scope="col">Usuario</th>
                            <th scope="col">Nombre</th>
                            <th scope="col">Teléfono</th>
                            <th scope="col">Fecha Nacimiento</th>
                            <th scope="col">Género</th>
                        </tr>
                    </thead>
                    <tbody id="tUsuarios"></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <center>
                    <button id="btnCancelUser" type="button" data-dismiss="modal" onclick="resetFormUser();" class="btn btn-danger"><i class="fas fa-times"></i> Cancelar</button>
                </center>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Selección del libro a prestar -->
<div class="modal fade" id="staticBook" data-backdrop="static" data-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tituloModal"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-row align-items-center">
                    <div class="form-group col col-sm-12 col-md-4 col-lg-5">
                        <label for="LibroSearch">Título del Libro</label>
                        <input id="LibroSearch" type="text" class="form-control" placeholder="Título del Libro">
                    </div>
                    <div class="form-group col col-sm-12 col-md-4 col-lg-3">
                        <label for="AutorSearch">Autor</label>
                        <select id="AutorSearch" class="form-control"></select>
                    </div>
                    <div class="form-group col col-sm-12 col-md-4 col-lg-3">
                        <label for="GeneroSearch">Género</label>
                        <select id="GeneroSearch" class="form-control"></select>
                    </div>
                    <div class="form-group col-1 col-sm-12 col-md-1 col-lg-1 d-flex justify-content-end mt-auto">
                        <button class="btn btn-success" id="btnSearch" onclick="buscarLibro(true)">Buscar</button>
                    </div>
                </div><br />

                <div class="row" id="renderLibrosActivos">
                </div>
            </div>
            <div class="modal-footer">
                <center>
                    <button id="btnCancelBook" type="button" data-dismiss="modal" onclick="resetFormBook();" class="btn btn-danger"><i class="fas fa-times"></i> Cancelar</button>
                </center>
            </div>
        </div>
    </div>
</div>

<script src="~/js/prestamos/prs.js"></script>
<script src="~/js/prestamos/prs.logs.js"></script>
<script src="~/js/prestamos/prs.actions.js"></script>