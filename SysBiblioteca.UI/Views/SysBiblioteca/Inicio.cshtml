@{
    ViewData["Title"] = "Inicio";
    Layout = "~/Views/Shared/_emptyLayout.cshtml";
}

<!--Subheader-->
<div class="subheader py-6 py-lg-8 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h2 class="text-dark font-weight-bold my-1 mr-5">Dashboard</h2>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <small class="text-muted font-weight-bold" id="fechaHoy"></small>
        </div>
    </div>
</div>

<!--Cuerpo-->
<div class="d-flex flex-column-fluid">
    <div class="container">

        <!-- Tarjetas de resumen -->
        <div class="row mb-5">
            <!-- Préstamos pendientes de entrega -->
            <div class="col-sm-6 col-xl-3 mb-4">
                <div class="card card-custom bg-warning-o-30">
                    <div class="card-body d-flex align-items-center p-5">
                        <div class="mr-5">
                            <span class="svg-icon svg-icon-3x svg-icon-warning">
                                <i class="fas fa-clock fa-2x text-warning"></i>
                            </span>
                        </div>
                        <div>
                            <h1 class="font-weight-bolder mb-0" id="cntPendientes">—</h1>
                            <span class="text-muted font-weight-bold">Préstamos pendientes</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Préstamos activos -->
            <div class="col-sm-6 col-xl-3 mb-4">
                <div class="card card-custom bg-primary-o-30">
                    <div class="card-body d-flex align-items-center p-5">
                        <div class="mr-5">
                            <i class="fas fa-book-open fa-2x text-primary"></i>
                        </div>
                        <div>
                            <h1 class="font-weight-bolder mb-0" id="cntActivos">—</h1>
                            <span class="text-muted font-weight-bold">Préstamos activos</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Usuarios registrados -->
            <div class="col-sm-6 col-xl-3 mb-4">
                <div class="card card-custom bg-success-o-30">
                    <div class="card-body d-flex align-items-center p-5">
                        <div class="mr-5">
                            <i class="fas fa-users fa-2x text-success"></i>
                        </div>
                        <div>
                            <h1 class="font-weight-bolder mb-0" id="cntUsuarios">—</h1>
                            <span class="text-muted font-weight-bold">Usuarios activos</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Multas pendientes -->
            <div class="col-sm-6 col-xl-3 mb-4">
                <div class="card card-custom bg-danger-o-30">
                    <div class="card-body d-flex align-items-center p-5">
                        <div class="mr-5">
                            <i class="fas fa-exclamation-triangle fa-2x text-danger"></i>
                        </div>
                        <div>
                            <h1 class="font-weight-bolder mb-0" id="cntMultas">—</h1>
                            <span class="text-muted font-weight-bold">Multas pendientes</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tablas de detalle -->
        <div class="row">

            <!-- Préstamos pendientes de entrega -->
            <div class="col-lg-6 mb-5">
                <div class="card card-custom">
                    <div class="card-header">
                        <h6 class="card-title font-weight-bold">
                            <i class="fas fa-clock text-warning mr-2"></i> Pendientes de entrega
                        </h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Libro</th>
                                        <th>Usuario</th>
                                        <th class="text-center">Estado</th>
                                    </tr>
                                </thead>
                                <tbody id="tDashPendientes">
                                    <tr><td colspan="3" class="text-center text-muted py-3">Cargando...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Préstamos activos -->
            <div class="col-lg-6 mb-5">
                <div class="card card-custom">
                    <div class="card-header">
                        <h6 class="card-title font-weight-bold">
                            <i class="fas fa-book-open text-primary mr-2"></i> Préstamos en curso
                        </h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Libro</th>
                                        <th>Usuario</th>
                                        <th class="text-center">Estado</th>
                                    </tr>
                                </thead>
                                <tbody id="tDashActivos">
                                    <tr><td colspan="3" class="text-center text-muted py-3">Cargando...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    var api = localStorage.getItem('apiURL');
    var pkg = {
        Token: localStorage.getItem('UserToken'),
        ActualRute: window.location.hash.replace('#', '')
    };

    // Fecha actual
    document.getElementById('fechaHoy').textContent = new Date().toLocaleDateString('es-SV', {
        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
    });

    function estadoBadge(estado) {
        var color = { 'A tiempo': 'success', 'Demorado': 'danger', 'Pendiente': 'warning' }[estado] || 'secondary';
        return '<span class="badge badge-' + color + '">' + estado + '</span>';
    }

    // Préstamos pendientes
    $.ajax({
        type: 'POST', url: api + 'Prestamos/GetPendingLoans',
        contentType: 'Application/json', data: JSON.stringify(pkg),
        success: function (data) {
            document.getElementById('cntPendientes').textContent = data.resultado == 1 ? data.datos.length : 0;
            var html = '';
            if (data.resultado == 1 && data.datos.length > 0) {
                $.each(data.datos.slice(0, 8), function () {
                    html += '<tr><td>' + this.libro.libro + '</td><td>' + this.usuario +
                            '</td><td class="text-center">' + estadoBadge(this.estado) + '</td></tr>';
                });
            } else {
                html = '<tr><td colspan="3" class="text-center text-muted py-3">Sin registros</td></tr>';
            }
            $('#tDashPendientes').html(html);
        }
    });

    // Préstamos activos
    $.ajax({
        type: 'POST', url: api + 'Prestamos/GetOngoingLoans',
        contentType: 'Application/json', data: JSON.stringify(pkg),
        success: function (data) {
            document.getElementById('cntActivos').textContent = data.resultado == 1 ? data.datos.length : 0;
            var html = '';
            if (data.resultado == 1 && data.datos.length > 0) {
                $.each(data.datos.slice(0, 8), function () {
                    html += '<tr><td>' + this.libro.libro + '</td><td>' + this.usuario +
                            '</td><td class="text-center">' + estadoBadge(this.estado) + '</td></tr>';
                });
            } else {
                html = '<tr><td colspan="3" class="text-center text-muted py-3">Sin registros</td></tr>';
            }
            $('#tDashActivos').html(html);
        }
    });

    // Usuarios activos
    $.ajax({
        type: 'POST', url: api + 'Seguridad/GetUsuarios',
        contentType: 'Application/json', data: JSON.stringify(pkg),
        success: function (data) {
            document.getElementById('cntUsuarios').textContent = data.resultado == 1 ? data.datos.length : 0;
        }
    });

    // Multas pendientes
    $.ajax({
        type: 'POST', url: api + 'Multas/GetMultasPendientes',
        contentType: 'Application/json', data: JSON.stringify(pkg),
        success: function (data) {
            document.getElementById('cntMultas').textContent = data.resultado == 1 ? data.datos.length : 0;
        }
    });
</script>
