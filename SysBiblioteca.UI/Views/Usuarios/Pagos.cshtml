@{
    ViewData["Title"] = "Pagos";
    Layout = "~/Views/Shared/_emptyLayout.cshtml";
}

<!--Subheader-->
<div class="subheader py-6 py-lg-8 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h2 class="text-dark font-weight-bold my-1 mr-5">Gestión de Pago de Multas</h2>
            </div>
        </div>
    </div>
</div>

<!--Cuerpo del Docto-->
<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="card card-custom">
            <div class="card-body">
                <!-- Nav tabs -->
                <ul class="nav nav-tabs justify-content-start" id="EncabezadoTabs">
                    <li class='nav-item' id="tabActivos">
                        <a class='nav-link ' data-toggle='tab' href='#MultasPendientes'>Multas Pendientes de Pago</a>
                    </li>
                    <li class='nav-item' id="tabHistorial">
                        <a class='nav-link' data-toggle='tab' href='#MultasPagadas'>Multas Pagadas</a>
                    </li>
                </ul>

                <!-- Tabs-->
                <div class="tab-content" Id="CuerpoTabs">

                    @*Multas Pendientes de Pago*@
                    <div class='tab-pane fade' id='MultasPendientes'>
                        <br />
                        <table id="tablePendientes" class="table table-hover">
                            <thead class="thead-dark">
                                <tr>
                                    <th scope="col" width="25"></th>
                                    <th scope="col">Libro</th>
                                    <th scope="col">Días Retraso</th>
                                    <th scope="col">Monto</th>
                                    <th scope="col">Estado Prestamo</th>
                                </tr>
                            </thead>
                            <tbody id="tPendientes"></tbody>
                        </table>
                    </div>

                    @*Multas Pagadas*@
                    <div class='tab-pane fade' id='MultasPagadas'>
                        <br />
                        <table id="tablePagadas" class="table table-hover">
                            <thead class="thead-dark">
                                <tr>
                                    <th scope="col" width="25"></th>
                                    <th scope="col">Libro</th>
                                    <th scope="col">Días Retraso</th>
                                    <th scope="col">Monto</th>
                                    <th scope="col">Usuario Aprobó</th>
                                    <th scope="col">Fecha Aprobación</th>
                                </tr>
                            </thead>
                            <tbody id="tPagadas"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Cobro de Multa al Prestamo tardío -->
<div class="modal fade" id="staticFine" data-backdrop="static" data-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Multa por Retraso</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="dataMulta">
                    <div class="row">
                        <div class="col">
                            <div class="alert alert-warning text-center font-weight-bolder" role="alert">
                                Por Favor, suba el comprobante de la transferencia a la cuenta N°: 1234567890 del Banco GuardaPisto a nombre de SysBiblioteca S.A. de C.V.
                            </div>
                        </div>
                    </div>

                    <div class="row" hidden>
                        <div class="col">
                            <input id="IdMulta" type="number" class="form-control" disabled>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="input-group mb-3">
                                <input type="file" class="form-control" id="ComprobantePago" accept="image/*">
                                <label class="input-group-text" for="ComprobantePago">Seleccionar Comprobante</label>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row mt-3">
                        <div class="col-6">
                            <label for="DiasRetraso" class="form-label">Días de Retrazo</label>
                            <input id="DiasRetraso" type="text" class="form-control" disabled>
                        </div>
                        <div class="col-6">
                            <label for="TotalPago" class="form-label">Total a Pagar</label>
                            <div class="input-group mb-3">
                                <span class="input-group-text">$</span>
                                <input id="dollars" type="text" class="form-control" aria-label="Amount (to the nearest dollar)" value="10" disabled>
                                <span id="cents" class="input-group-text">.50</span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-2">
                            <div id="miniaturaContainer"></div>
                        </div>
                        <div class="col-10">
                            <label for="Libro" class="form-label">Libro del Préstamo</label>
                            <input id="Libro" type="text" class="form-control" disabled>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <center>
                    <button id="btnCargar" type="button" class="btn btn-info font-weight-bold"><i class="fas fa-file-invoice-dollar"></i> Cargar Compronate </button>
                    <button id="btnCancel" type="button" data-dismiss="modal" class="btn btn-danger" onclick="resetForm();"><i class="fas fa-times"></i> Cancelar</button>
                </center>
            </div>
        </div>
    </div>
</div>

<script src="~/js/multas/mlt.js"></script>
<script src="~/js/multas/mlt.logs.js"></script>
<script src="~/js/multas/mlt.actions.js"></script>