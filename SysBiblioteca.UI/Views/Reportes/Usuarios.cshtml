@{
    ViewData["Title"] = "Reportes de Usuarios";
    Layout = "~/Views/Shared/_emptyLayout.cshtml";
}

<!--Subheader-->
<div class="subheader py-6 py-lg-8 subheader-transparent" id="kt_subheader">
    <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
        <div class="d-flex align-items-center flex-wrap mr-1">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h2 class="text-dark font-weight-bold my-1 mr-5">Reportes de Libros</h2>
            </div>
        </div>
    </div>
</div>

<!--Cuerpo del Docto-->
<div class="d-flex flex-column-fluid">
    <div class="container">
        <div class="card card-custom">
            <div class="card-body">
                <!-- Nav tabs -->
                <ul class="nav nav-tabs justify-content-start" id="EncabezadoTabs">
                    <li class='nav-item' id="tabActivos">
                        <a class='nav-link ' data-toggle='tab' href='#PrestamosActivos'>Prestamos Activos</a>
                    </li>
                    <li class='nav-item' id="tabPendientes">
                        <a class='nav-link' data-toggle='tab' href='#HistorialPrestamos'>Prestamos Finalizados</a>
                    </li>
                </ul>

                <!-- Tabs-->
                <div class="tab-content" Id="CuerpoTabs">
                    @*Prestamos Activos*@
                    <div class='tab-pane fade' id='PrestamosActivos'>
                        <!--Subheader-->
                        <div class="subheader py-6 py-lg-8 subheader-transparent" id="kt_subheader">
                            <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
                                <div class="d-flex align-items-center flex-wrap mr-1">
                                    <div class="d-flex align-items-baseline flex-wrap mr-5">
                                        <h2 class="text-dark font-weight-bold my-1 mr-5">Reporte de Usuarios con Préstamos Activos</h2>
                                    </div>
                                </div>

                                <button type="button" class="btn btn-success" id="btnReportePrestamosActivos">
                                    <i class="fas fa-file-excel"></i> Exportar Reporte a Excel
                                </button>
                            </div>
                        </div><hr />

                        <table id="tableActivos" class="table table-hover">
                            <thead class="thead-dark">
                                <tr>
                                    <th scope="col" width="25"></th>
                                    <th scope="col">Libro</th>
                                    <th scope="col">Días Prestamo</th>
                                    <th scope="col">Fecha Prestamo</th>
                                    <th scope="col">Usuario Prestamo</th>
                                    <th scope="col">Usuario Entregó</th>
                                    <th scope="col">Estado Prestamo</th>
                                </tr>
                            </thead>
                            <tbody id="tActivos"></tbody>
                        </table>
                    </div>

                    @*Prestamos Finalizados*@
                    <div class='tab-pane fade' id='HistorialPrestamos'>
                        <!--Subheader-->
                        <div class="subheader py-6 py-lg-8 subheader-transparent" id="kt_subheader">
                            <div class="container d-flex align-items-center justify-content-between flex-wrap flex-sm-nowrap">
                                <div class="d-flex align-items-center flex-wrap mr-1">
                                    <div class="d-flex align-items-baseline flex-wrap mr-5">
                                        <h2 class="text-dark font-weight-bold my-1 mr-5">Reporte de Usuarios con Préstamos Activos</h2>
                                    </div>
                                </div>
                                
                                <button type="button" class="btn btn-success" id="btnReportePrestamosFinalizados">
                                    <i class="fas fa-file-excel"></i> Exportar Reporte a Excel
                                </button>
                            </div>
                        </div><hr />

                        <div class="d-flex flex-row-reverse">
                            <div class="form-group p-2">
                                <label for="FechaDesde">Fecha Desde</label>
                                <input id="FechaDesde" class="form-control" placeholder="DD/MM/AAAA" autocomplete="off" />
                            </div>

                            <div class="form-group p-2">
                                <label for="FechaHasta">Fecha Hasta</label>
                                <input id="FechaHasta" class="form-control" placeholder="DD/MM/AAAA" autocomplete="off" />
                            </div>
                            <div class="p-2">
                                <button type="button" class="btn btn-success" onclick="loadPrestamosFinalizados();">
                                    <i class="fas fa-search"></i> Aplicar Filtro
                                </button>
                            </div>
                        </div><hr />

                        <table id="tableHistorial" class="table table-hover">
                            <thead class="thead-dark">
                                <tr>
                                    <th scope="col" width="25"></th>
                                    <th scope="col">Libro</th>
                                    <th scope="col">Usuario Prestamo</th>
                                    <th scope="col">Días Prestamo</th>
                                    <th scope="col">Fecha Prestamo</th>
                                    <th scope="col">Fecha Devolucion</th>
                                    <th scope="col">Usuario Recibió</th>
                                </tr>
                            </thead>
                            <tbody id="tHistorial"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/reportes/usrs.js"></script>
<script src="~/js/reportes/usrs.logs.js"></script>
<script src="~/js/reportes/usrs.actions.js"></script>