                        <div class="d-flex align-items-center flex-wrap mr-1">
                            <div class="d-flex align-items-baseline flex-wrap mr-5">
                                <h2 class="text-dark font-weight-bold my-1 mr-5" id="nombreSeccion"></h2>
                            </div>
                        </div>

                        <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#staticEstanteria" onclick="resetFormEstanterias();">
                            <i class="fas fa-plus"></i> Nueva Estantería
                        </button>
                    </div>
                </div>

                <div class="row" hidden>
                    <div class="col">
                        <input id="IdSeccionEstanteria" type="number" class="form-control" disabled>
                    </div>
                </div>

                <br />
                <table id="tableEstanterias" class="table table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th scope="col">Estanteria</th>
                            <th scope="col">UsuarioCreacion</th>
                            <th scope="col">FechaCreacion</th>
                            <th scope="col">UsuarioModificacion</th>
                            <th scope="col">FechaModificacion</th>
                            <th scope="col" class='text-center' width="150">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tEstanterias"></tbody>
                </table>

                <center>
                    <button id="btnCloseEstanterias" type="button" data-dismiss="modal" class="btn btn-danger"><i class="fas fa-times"></i> Cerrar</button>
                </center>
            </div>
        </div>
    </div>
</div>

